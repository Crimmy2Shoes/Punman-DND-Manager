{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test src/character.test.mjs src/sheetModel.test.mjs src/pugilist.test.mjs src/companionRules.test.mjs src/ruleLibrary.test.mjs src/expansion.test.mjs src/playerAccess.test.mjs src/notesModel.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:players": "playwright test --config playwright.players.config.ts",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "dev": "vite",
    "dev:players": "vite --mode players --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "build:players": "tsc -b && vite build --mode players && node scripts/check-player-build.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:players": "vite preview --mode players"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
